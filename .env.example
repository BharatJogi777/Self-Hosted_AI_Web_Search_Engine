# Copy to .env and replace every placeholder before starting Compose.
POSTGRES_DB=search_engine
POSTGRES_USER=search
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Comma-separated permitted crawl hosts. Do not include schemes or paths.
ALLOWED_DOMAINS=example.com

# Comma-separated API keys. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEYS=replace-with-a-long-random-api-key

# Ollama runs on the Mac host to conserve container memory.
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

SEARCH_RATE_LIMIT=60
SEARCH_RATE_WINDOW_SECONDS=60
SEARCH_CACHE_TTL_SECONDS=30

WORKER_CONCURRENCY=1
WORKER_LEASE_SECONDS=120
WORKER_POLL_SECONDS=1
WORKER_METRICS_PORT=9100

LOG_LEVEL=INFO
